{
  "DocumentName": "AWS-RunShellScript",
  "InstanceIds": ["i-0010b131c3757b993"],
  "Comment": "Deploy current wedding invitation application release",
  "Parameters": {
    "commands": [
      "set -Eeuo pipefail",
      "aws s3 cp 's3://fresh-deploy-wedding-866409327331-ap-southeast-2/releases/cf564060cd6d1cbb6035dd4ec1246ab731c0011740f3271984d5868e066bb84c.zip' /tmp/wedding-redeploy.zip --region ap-southeast-2",
      "unzip -oq /tmp/wedding-redeploy.zip -d /opt/wedding-app || test -f /opt/wedding-app/package.json",
      "chown -R ec2-user:ec2-user /opt/wedding-app",
      "install -d -o ec2-user -g ec2-user -m 0750 /opt/wedding-app/uploads",
      "cd /opt/wedding-app && runuser -u ec2-user -- /usr/bin/npm-22 ci --omit=dev",
      "systemctl restart wedding-app.service",
      "systemctl is-active wedding-app.service",
      "curl --fail --silent --show-error http://127.0.0.1:8080/api/health",
      "rm -f /tmp/wedding-redeploy.zip"
    ]
  }
}
