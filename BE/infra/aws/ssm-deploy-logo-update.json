{
  "DocumentName": "AWS-RunShellScript",
  "InstanceIds": ["i-0010b131c3757b993"],
  "Comment": "Deploy TA and HN wedding admin logo",
  "Parameters": {
    "commands": [
      "set -Eeuo pipefail",
      "aws s3 cp 's3://fresh-deploy-wedding-866409327331-ap-southeast-2/releases/1615de4445446948674243a6d550b044c602a82a9d45cba490be6873890bfbcc.zip' /tmp/wedding-logo-update.zip --region ap-southeast-2",
      "unzip -oq /tmp/wedding-logo-update.zip -d /opt/wedding-app || test -f /opt/wedding-app/package.json",
      "chown -R ec2-user:ec2-user /opt/wedding-app",
      "install -d -o ec2-user -g ec2-user -m 0750 /opt/wedding-app/uploads",
      "cd /opt/wedding-app && runuser -u ec2-user -- /usr/bin/npm-22 ci --omit=dev",
      "cd /opt/wedding-app && runuser -u ec2-user -- /usr/bin/npm-22 run db:init",
      "systemctl restart wedding-app.service",
      "for attempt in $(seq 1 12); do if curl --fail --silent --show-error http://127.0.0.1:8080/api/health; then rm -f /tmp/wedding-logo-update.zip; exit 0; fi; sleep 5; done; exit 1"
    ]
  }
}
